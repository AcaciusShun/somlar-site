<dialog class="article-image-dialog" aria-label="查看原图">
  <button class="text-button" type="button" data-close-image>关闭图片</button>
  <img alt="" />
</dialog>

<script>
  import { createDialogController } from "@/lib/dialog";

  const prose = document.querySelector<HTMLElement>(".reading-prose");

  if (prose) {
    prose.querySelectorAll<HTMLPreElement>("pre").forEach((pre) => {
      pre.tabIndex = 0;
      pre.setAttribute("aria-label", "代码，可横向滚动");
      if (!navigator.clipboard) return;

      const block = document.createElement("div");
      block.className = "code-block";
      const tools = document.createElement("div");
      tools.className = "code-tools";
      const button = document.createElement("button");
      button.type = "button";
      button.className = "text-button";
      button.textContent = "复制代码";
      button.setAttribute("aria-live", "polite");
      pre.before(block);
      tools.append(button);
      block.append(tools, pre);

      button.addEventListener("click", async () => {
        try {
          await navigator.clipboard.writeText(pre.querySelector("code")?.textContent || "");
          button.textContent = "已复制";
        } catch {
          button.textContent = "复制失败，请手动选择";
        }
        window.setTimeout(() => { button.textContent = "复制代码"; }, 1800);
      });
    });

    prose.querySelectorAll<HTMLTableElement>("table").forEach((table) => {
      const scroll = document.createElement("div");
      scroll.className = "table-scroll";
      scroll.tabIndex = 0;
      scroll.setAttribute("role", "region");
      scroll.setAttribute("aria-label", `${table.caption?.textContent || "文章表格"}，可左右滚动`);
      table.before(scroll);
      scroll.append(table);
    });

    const toc = document.querySelector<HTMLDetailsElement>(".article-toc");
    toc?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => {
      if (matchMedia("(max-width: 600px), (pointer: coarse)").matches) toc.open = false;
    }));

    const dialog = document.querySelector<HTMLDialogElement>(".article-image-dialog");
    const fullImage = dialog?.querySelector("img");
    let imageRequest = 0;

    if (dialog && fullImage) {
      const controller = createDialogController(dialog);
      prose.querySelectorAll<HTMLImageElement>("img").forEach((image) => {
        if (image.closest("a")) return;
        const media = image.closest("picture") || image;
        const link = document.createElement("a");
        link.className = "image-link";
        link.href = image.dataset.fullImage || image.src;
        link.setAttribute("aria-label", image.alt ? `查看原图：${image.alt}` : "查看原图");
        media.before(link);
        link.append(media);
        link.addEventListener("click", (event) => {
          if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
          event.preventDefault();
          const request = ++imageRequest;
          const preview = image.currentSrc || image.src;
          const original = image.dataset.fullImage || image.src;
          fullImage.src = preview;
          fullImage.alt = image.alt;
          controller.open(link);
          if (original !== preview) {
            const preload = new Image();
            preload.decoding = "async";
            preload.onload = () => {
              if (dialog.open && request === imageRequest) fullImage.src = original;
            };
            preload.src = original;
          }
        });
      });

      dialog.querySelector("[data-close-image]")?.addEventListener("click", () => dialog.close());
    }
  }
</script>
