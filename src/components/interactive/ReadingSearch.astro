<section class="reading-search" id="search" aria-label="文章搜索" data-pagefind-ignore data-dev={import.meta.env.DEV ? "true" : undefined}>
  <form class="search-content" role="search">
    <label class="visually-hidden" for="reading-search-input">搜索文章</label>
    <div class="search-input-row">
      <input id="reading-search-input" type="search" autocomplete="off" autocapitalize="none" enterkeyhint="search" placeholder="搜索文章…" />
      <button class="text-button search-clear" type="reset" hidden>清除</button>
    </div>
    <p class="search-status muted" role="status" aria-live="polite"></p>
    <ul class="search-results"></ul>
    <noscript><p>搜索需要 JavaScript。你也可以直接浏览下面的年度文章列表。</p></noscript>
  </form>
</section>

<!-- Keep the runtime Pagefind import outside Vite's inline-module preloader. -->
<script is:inline type="module">
  const searchRegion = document.querySelector(".reading-search");
  const input = document.querySelector("#reading-search-input");
  const status = document.querySelector(".search-status");
  const results = document.querySelector(".search-results");
  const form = searchRegion?.querySelector("form");
  const clear = form?.querySelector("[type=reset]");
  const archive = document.querySelector("#blog-archive");

  if (searchRegion && input && status && results) {
    let indexPromise;
    let requestId = 0;
    let timer;

    const getIndex = () => {
      if (!indexPromise) {
        const indexUrl = "/pagefind/pagefind.js";
        indexPromise = import(/* @vite-ignore */ indexUrl).then(async (index) => {
          await index.init();
          return index;
        }).catch((error) => {
          indexPromise = undefined;
          throw error;
        });
      }
      return indexPromise;
    };

    const search = async (query, id) => {
      results.replaceChildren();
      if (archive) archive.hidden = Boolean(query);
      if (clear) clear.hidden = !query;
      if (!query) {
        status.textContent = "";
        return;
      }

      status.textContent = "正在搜索…";
      try {
        const index = await getIndex();
        const response = await index.search(query);
        const pages = await Promise.all(response.results.slice(0, 10).map((result) => result.data()));
        if (id !== requestId) return;

        status.textContent = response.results.length
          ? `${response.results.length} 篇匹配文章${response.results.length > 10 ? "，显示前 10 篇" : ""}`
          : "没有找到相关的文章，试试其他关键词。";

        for (const page of pages) {
          const item = document.createElement("li");
          const link = document.createElement("a");
          link.href = page.url;
          link.textContent = page.meta.title || "查看文章";
          const excerpt = document.createElement("p");
          excerpt.className = "muted";
          excerpt.textContent = new DOMParser().parseFromString(page.excerpt, "text/html").body.textContent;
          item.append(link, excerpt);
          results.append(item);
        }
      } catch {
        if (id !== requestId) return;
        if (archive) archive.hidden = false;
        status.textContent = searchRegion.dataset.dev === "true"
          ? "开发预览中没有搜索索引，请在构建后的预览中使用搜索。"
          : "暂时无法加载搜索，请稍后再试。也可以浏览下方的年度列表。";
      }
    };

    input.addEventListener("input", () => {
      clearTimeout(timer);
      const id = ++requestId;
      const query = input.value.trim();
      timer = setTimeout(() => search(query, id), 180);
    });

    form?.addEventListener("reset", (event) => {
      event.preventDefault();
      clearTimeout(timer);
      input.value = "";
      search("", ++requestId);
      input.focus({ preventScroll: true });
    });

    form?.addEventListener("submit", (event) => {
      event.preventDefault();
      clearTimeout(timer);
      search(input.value.trim(), ++requestId);
      if (matchMedia("(pointer: coarse)").matches) input.blur();
    });

    const openFromHash = () => {
      if (location.hash === "#search") {
        input.focus({ preventScroll: true });
      }
    };
    window.addEventListener("hashchange", openFromHash);
    openFromHash();
  }
</script>

<style>
  .reading-search {
    margin-block: 0 1.5rem;
  }

  input {
    width: 100%;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid #8b969e;
    border-radius: 0;
    color: inherit;
    background: #fff;
    min-width: 0;
    min-height: 44px;
  }

  .search-clear { font-size: 0.875rem; }

  .search-input-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .search-input-row input { flex: 1; }
  input::-webkit-search-cancel-button { -webkit-appearance: none; appearance: none; }

  .search-status {
    margin-block: 0.75rem;
    font-size: 0.8125rem;
  }

  .search-status:empty,
  .search-results:empty { display: none; }

  .search-results {
    padding: 0;
    list-style: none;
    margin-block: 1.5rem 0;
  }

  .search-results :global(li) {
    margin-bottom: 1.75rem;
  }

  .search-results :global(a) { color: inherit; text-decoration: none; }

  .search-results :global(p) {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    margin: 0.4rem 0 0;
    font-size: 0.875rem;
    line-height: 1.8;
  }

  @media (hover: hover) and (pointer: fine) {
    .search-results :global(a:hover) { color: var(--reading-link); text-decoration: underline; }
  }
</style>
