---
import { siteConfig } from "@/lib/config";

interface Props {
  path: string;
  deferred?: boolean;
}

const { path, deferred = false } = Astro.props;
const envId = siteConfig.twikoo.envId;
---

{envId && (
  <section class="comments" id="comments" aria-label="评论">
    <div id="tcomment" />
  </section>
)}

<script is:inline define:vars={{ envId, path, deferred }}>
  if (envId) {
    let started = false;
    const initTwikoo = async () => {
      if (started) return;
      started = true;
      const container = document.getElementById("tcomment");
      container.textContent = "正在加载评论…";
      try {
        const twikoo = await new Promise((resolve, reject) => {
          if (window.twikoo?.init) return resolve(window.twikoo);
          const script = document.createElement("script");
          script.src = "https://cdn.jsdelivr.net/npm/twikoo@1.7.9/dist/twikoo.min.js";
          script.onload = () => window.twikoo?.init
            ? resolve(window.twikoo)
            : reject(new Error("Comment script did not initialize"));
          script.onerror = () => {
            script.remove();
            reject(new Error("Comment script could not be loaded"));
          };
          document.head.appendChild(script);
        });
        await twikoo.init({
          envId,
          el: "#tcomment",
          path,
          lang: "zh-CN",
        });
      } catch (error) {
        console.warn("[评论] 加载失败", error);
        started = false;
        container.textContent = "评论暂时无法加载，请刷新页面后重试。";
      }
    };

    const disclosure = deferred ? document.getElementById("tcomment")?.closest("details") : null;
    if (disclosure) {
      disclosure.addEventListener("toggle", () => {
        if (disclosure.open) initTwikoo();
      });
      if (disclosure.open) initTwikoo();
    } else if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTwikoo);
    } else {
      initTwikoo();
    }
  }
</script>

<style is:global>
  .comments {
    margin-top: 1rem;
  }

  .tk-comments {
    font-family: inherit;
  }

  .tk-input .el-input__inner,
  .tk-input .el-textarea__inner {
    font-family: inherit;
    font-size: max(1rem, 16px);
    color: inherit;
    background: #fff;
    border: 1px solid #8b969e;
    border-radius: 4px;
  }

  .tk-input .el-input__inner:focus,
  .tk-input .el-textarea__inner:focus {
    border-color: var(--reading-link);
  }

  .tk-submit .tk-send-btn {
    border-color: var(--reading-link);
    border-radius: 3px;
    color: var(--reading-link);
    background: #fff;
    font: inherit;
  }

  .tk-comment {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--reading-rule);
  }

  .tk-content {
    font-size: 1rem;
    line-height: 1.8;
    color: inherit;
  }

  .comments .tk-content img {
    max-width: min(100%, 300px);
    height: auto;
  }

  .comments .tk-content :is(pre, table) {
    max-width: 100%;
    overflow-x: auto;
    overscroll-behavior-inline: contain;
  }

  .comments .tk-content table {
    display: block;
  }

  .tk-nick {
    font-weight: 600;
    color: inherit;
  }

  .tk-time,
  .tk-action-icon {
    color: var(--reading-muted);
    font-size: 0.9rem;
  }

  .tk-comments-count {
    font-family: inherit;
    color: inherit;
  }

  .comments .tk-actions button,
  .comments .tk-action-link { color: var(--reading-link); }

  .comments :is(input, textarea, button):focus-visible {
    outline: 2px solid var(--reading-link);
    outline-offset: 3px;
  }

  @media (pointer: coarse) {
    .comments .tk-submit .el-button,
    .comments .tk-meta-input .el-input__inner {
      min-height: 44px;
    }

    .comments .tk-comment .tk-actions,
    .comments .tk-comment:hover .tk-actions {
      display: inline-flex;
      flex-wrap: wrap;
    }

    .comments .tk-actions button,
    .comments .tk-action-link,
    .comments .tk-submit-action-icon {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 44px;
      min-height: 44px;
    }

    .comments .tk-submit-action-icon {
      margin-right: 0;
    }

    .comments .tk-submit-action-icon:active { background: var(--reading-code); }
    .comments .tk-submit-action-icon svg:hover { opacity: 1; }
    .comments .tk-nick-link:hover { color: inherit; }
    .comments .el-button:not(.is-disabled):hover {
      color: var(--reading-link);
      border-color: var(--reading-link);
      background: #fff;
    }

    .comments .tk-row {
      flex-wrap: wrap;
    }

    .comments .tk-action-link:not(.tk-liked):not(.tk-disliked) .tk-action-icon {
      display: block;
    }

    .comments .tk-action-link:not(.tk-liked):not(.tk-disliked) .tk-action-icon-solid {
      display: none;
    }
  }
</style>
