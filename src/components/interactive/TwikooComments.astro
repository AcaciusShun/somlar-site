---
import { siteConfig } from "@/lib/config";

interface Props {
  path: string;
  deferred?: boolean;
}

const { path, deferred = false } = Astro.props;
const envId = siteConfig.twikoo.envId;
---

{envId && (
  <section class="comments" id="comments" aria-label="评论">
    <div id="tcomment" />
  </section>
)}

<script is:inline define:vars={{ envId, path, deferred }}>
  if (envId) {
    let started = false;
    const initTwikoo = () => {
      if (started) return;
      started = true;
      const script = document.createElement("script");
      script.src = "https://cdn.jsdelivr.net/npm/twikoo@1.7.9/dist/twikoo.min.js";
      script.onload = () => {
        twikoo.init({
          envId,
          el: "#tcomment",
          path,
          lang: "zh-CN",
        });
      };
      script.onerror = () => {
        started = false;
        document.getElementById("tcomment").textContent = "评论暂时无法加载，请稍后重新展开。";
        script.remove();
      };
      document.head.appendChild(script);
    };

    const disclosure = deferred ? document.getElementById("tcomment")?.closest("details") : null;
    if (disclosure) {
      disclosure.addEventListener("toggle", () => {
        if (disclosure.open) initTwikoo();
      });
    } else if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initTwikoo);
    } else {
      initTwikoo();
    }
  }
</script>

<style is:global>
  .comments {
    margin-top: 1rem;
  }

  .tk-comments {
    font-family: inherit;
  }

  .tk-input .el-input__inner,
  .tk-input .el-textarea__inner {
    font-family: inherit;
    font-size: max(1rem, 16px);
    color: inherit;
    background: #fff;
    border: 1px solid var(--reading-rule);
    border-radius: 3px;
  }

  .tk-input .el-input__inner:focus,
  .tk-input .el-textarea__inner:focus {
    border-color: var(--reading-link);
  }

  .tk-submit .tk-send-btn {
    border-color: var(--reading-link);
    border-radius: 3px;
    color: var(--reading-link);
    background: #fff;
    font: inherit;
  }

  .tk-comment {
    margin-bottom: 1rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--reading-rule);
  }

  .tk-content {
    font-size: 0.95rem;
    line-height: 1.8;
    color: inherit;
  }

  .tk-nick {
    font-weight: 600;
    color: inherit;
  }

  .tk-time,
  .tk-action-icon {
    color: var(--reading-muted);
    font-size: 0.9rem;
  }

  .tk-comments-count {
    font-family: inherit;
    color: inherit;
  }
</style>
