---
interface Props {
  title: string;
  headings: { depth: number; slug: string; text: string }[];
}
const { title, headings } = Astro.props;
---

<aside class="reading-toolbar" aria-label="阅读工具" data-pagefind-ignore hidden>
  <div class="reading-toolbar__inner">
    <a class="reading-toolbar__back" href="/blog" aria-label="返回全部文章">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
        <path d="m14 6-6 6 6 6" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <span>文章</span>
    </a>
    <a class="reading-toolbar__title" href="#article-title" aria-label={"回到文章开头：" + title}>{title}</a>
    {headings.length > 0 && (
      <button class="reading-toolbar__contents" type="button" aria-haspopup="dialog" aria-controls="reading-contents" data-open-contents>
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="M8 6h12M8 12h12M8 18h12M3 6h.01M3 12h.01M3 18h.01" stroke-linecap="round" />
        </svg>
        目录
      </button>
    )}
  </div>
  <progress class="reading-progress" max="100" value="0" aria-label="阅读进度">0%</progress>
</aside>

{headings.length > 0 && (
  <dialog class="utility-dialog contents-dialog" id="reading-contents" aria-labelledby="contents-title" data-pagefind-ignore>
    <header class="utility-dialog__header">
      <h2 id="contents-title">文章目录</h2>
      <form method="dialog">
        <button class="icon-button" aria-label="关闭目录">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
            <path d="m6 6 12 12M18 6 6 18" stroke-linecap="round" />
          </svg>
        </button>
      </form>
    </header>
    <nav class="contents-dialog__links" aria-label="跳转到章节">
      <ul>
        {headings.map((heading) => (
          <li class:list={{ "toc-subheading": heading.depth === 3 }}>
            <a href={"#" + heading.slug}>{heading.text}</a>
          </li>
        ))}
      </ul>
    </nav>
  </dialog>
)}

<script>
  import { createDialogController } from "@/lib/dialog";

  const toolbar = document.querySelector<HTMLElement>(".reading-toolbar");
  const header = document.querySelector<HTMLElement>(".article-header");
  const prose = document.querySelector<HTMLElement>(".reading-prose");
  const progress = toolbar?.querySelector<HTMLProgressElement>("progress");
  const dialog = document.querySelector<HTMLDialogElement>("#reading-contents");
  const opener = toolbar?.querySelector<HTMLButtonElement>("[data-open-contents]");

  if (dialog && opener) {
    const controller = createDialogController(dialog);
    const links = [...dialog.querySelectorAll<HTMLAnchorElement>("a[href^='#']")];
    opener.addEventListener("click", () => {
      const current = links.filter((link) => {
        const heading = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        return heading && heading.getBoundingClientRect().top <= 96;
      }).at(-1) || links[0];
      links.forEach((link) => {
        if (link === current) link.setAttribute("aria-current", "location");
        else link.removeAttribute("aria-current");
      });
      controller.open(opener);
      current?.scrollIntoView({ block: "nearest" });
    });
    links.forEach((link) => {
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        const target = document.getElementById(decodeURIComponent(link.hash.slice(1)));
        if (!target) return;
        event.preventDefault();
        controller.close();
        history.pushState(null, "", link.hash);
        target.scrollIntoView({ block: "start" });
        target.tabIndex = -1;
        target.focus({ preventScroll: true });
      });
    });
  }

  if (toolbar && header && prose && progress) {
    let queued = false;
    const update = () => {
      queued = false;
      const headerRect = header.getBoundingClientRect();
      const bodyRect = prose.getBoundingClientRect();
      toolbar.hidden = headerRect.bottom > 0 || bodyRect.bottom <= 56;
      const inset = Math.max(56, toolbar.getBoundingClientRect().height);
      progress.hidden = bodyRect.height <= window.innerHeight - inset;
      const range = Math.max(1, bodyRect.height - window.innerHeight + inset);
      const percent = Math.round(Math.min(1, Math.max(0, (inset - bodyRect.top) / range)) * 100);
      progress.value = percent;
      progress.textContent = percent + "%";
    };
    const schedule = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(update);
    };
    window.addEventListener("scroll", schedule, { passive: true });
    window.addEventListener("resize", schedule, { passive: true });
    const observer = new ResizeObserver(schedule);
    observer.observe(prose);
    observer.observe(header);
    update();
  }
</script>
