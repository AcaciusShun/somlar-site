---
import { siteConfig } from "@/lib/config";
const analyticsEnabled = Boolean(siteConfig.analytics.measurementId);
---

{analyticsEnabled && (
  <aside class="analytics-consent" data-analytics-consent-panel hidden role="region" aria-labelledby="analytics-consent-title" data-pagefind-ignore>
    <h2 id="analytics-consent-title">要允许匿名化的阅读统计吗？</h2>
    <p>我使用 Google Analytics 了解哪些文章更有帮助。只有你同意后才会启用统计，不用于广告个性化。</p>
    <div class="analytics-consent__actions">
      <button type="button" data-consent-choice="rejected">仅必要</button>
      <button type="button" data-consent-choice="accepted">允许统计</button>
    </div>
  </aside>
)}

{analyticsEnabled && (
  <script is:inline>
    (() => {
      const panel = document.querySelector("[data-analytics-consent-panel]");
      if (!panel || !window.somlarAnalytics) return;
      let returnFocus = null;

      const show = (trigger) => {
        returnFocus = trigger ?? null;
        panel.hidden = false;
        if (trigger) panel.querySelector("button")?.focus();
      };
      const hide = () => {
        panel.hidden = true;
        returnFocus?.focus({ preventScroll: true });
        returnFocus = null;
      };

      panel.querySelectorAll("[data-consent-choice]").forEach((button) => {
        button.addEventListener("click", () => {
          window.somlarAnalytics.setChoice(button.dataset.consentChoice);
          hide();
        });
      });
      document.querySelectorAll("[data-analytics-settings]").forEach((button) => {
        button.addEventListener("click", () => show(button));
      });
      if (window.somlarAnalytics.readChoice() === null) show();
    })();
  </script>
)}

<style>
  .analytics-consent {
    margin-top: 1.5rem;
    padding: 1rem;
    border: 1px solid var(--reading-rule);
  }

  h2 {
    margin: 0;
    font-size: 1rem;
    line-height: 1.5;
  }

  p {
    margin: 0.5rem 0 0;
    color: var(--reading-muted);
    font-size: 0.9rem;
  }

  .analytics-consent__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  button {
    min-height: 44px;
    padding: 0.35rem 0.75rem;
    border: 1px solid #aaa;
    border-radius: 3px;
    color: inherit;
    background: #fff;
    font-size: 0.9rem;
    cursor: pointer;
  }

  button[data-consent-choice="accepted"] {
    border-color: var(--reading-link);
    color: var(--reading-link);
  }
</style>
