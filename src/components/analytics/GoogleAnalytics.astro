---
import { siteConfig } from "@/lib/config";

const measurementId = siteConfig.analytics.measurementId;
---

{measurementId && (
  <script is:inline define:vars={{ measurementId }}>
    (() => {
      const consentKey = "somlar.analytics-consent.v1";
      const disableKey = "ga-disable-" + measurementId;
      let memoryChoice = null;

      const readChoice = () => {
        try {
          const value = memoryChoice ?? localStorage.getItem(consentKey);
          return value === "accepted" || value === "rejected" ? value : null;
        } catch {
          return memoryChoice;
        }
      };

      const writeChoice = (value) => {
        memoryChoice = value;
        try { localStorage.setItem(consentKey, value); } catch {}
      };

      const clearAnalyticsCookies = () => {
        const names = document.cookie.split(";")
          .map((cookie) => cookie.split("=")[0].trim())
          .filter((name) => name === "_ga" || name.startsWith("_ga_"));
        const parts = location.hostname.split(".");
        const domains = parts.slice(0, -1).map((_, index) => parts.slice(index).join("."));
        for (const name of names) {
          const base = name + "=; Max-Age=0; Path=/; SameSite=Lax";
          document.cookie = base;
          for (const domain of domains) document.cookie = base + "; Domain=." + domain;
        }
      };

      const load = () => {
        if (window.__somlarGaLoaded) return;
        window.__somlarGaLoaded = true;
        window[disableKey] = false;
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () { window.dataLayer.push(arguments); };
        window.gtag("consent", "default", {
          analytics_storage: "granted",
          ad_storage: "denied",
          ad_user_data: "denied",
          ad_personalization: "denied",
        });
        window.gtag("js", new Date());
        window.gtag("config", measurementId, {
          allow_google_signals: false,
          allow_ad_personalization_signals: false,
        });

        const loader = document.createElement("script");
        loader.async = true;
        loader.src = "https://www.googletagmanager.com/gtag/js?id=" + encodeURIComponent(measurementId);
        loader.dataset.somlarGa = "loader";
        document.head.append(loader);
      };

      const setChoice = (value) => {
        if (value !== "accepted" && value !== "rejected") return;
        writeChoice(value);
        window[disableKey] = value !== "accepted";
        document.documentElement.dataset.analyticsConsent = value;

        if (value === "accepted") load();
        else clearAnalyticsCookies();

        window.dispatchEvent(new CustomEvent("somlar:analytics-consent", { detail: { value } }));
      };

      window.somlarAnalytics = { readChoice, setChoice };
      const choice = readChoice();
      window[disableKey] = choice !== "accepted";
      document.documentElement.dataset.analyticsConsent = choice ?? "unset";
      if (choice === "accepted") load();
      else clearAnalyticsCookies();
    })();
  </script>
)}
