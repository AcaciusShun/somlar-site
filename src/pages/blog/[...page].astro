---
import type { GetStaticPathsOptions } from "astro";
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import PostArchive from "@/components/content/PostArchive.astro";
import ReadingSearch from "@/components/interactive/ReadingSearch.astro";
import { getPublishedPosts } from "@/lib/blog";

// Keep existing pagination URLs reachable after moving to a single archive.
export async function getStaticPaths({ paginate }: GetStaticPathsOptions) {
  const posts = await getPublishedPosts();
  return paginate(posts, { pageSize: 10 });
}

const { page } = Astro.props;
if (page.currentPage > 1) return Astro.redirect("/blog");
const posts = await getPublishedPosts();
---

<ReadingLayout title="文章" description="技术实践、阅读笔记和日常随想，按年份归档。">
  <h1 class="visually-hidden">文章</h1>
  <ReadingSearch />
  <div id="blog-archive">
    <PostArchive posts={posts} />
  </div>
</ReadingLayout>
