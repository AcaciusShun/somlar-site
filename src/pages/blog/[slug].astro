---
import { render } from "astro:content";
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import { getPublishedPosts, formatISODate, postSlug } from "@/lib/blog";
import { siteConfig } from "@/lib/config";
import TwikooComments from "@/components/interactive/TwikooComments.astro";
import ArticleEnhancements from "@/components/interactive/ArticleEnhancements.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: { post, prev: posts[index + 1] || null, next: posts[index - 1] || null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
---

<ReadingLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover?.image}
  publishedTime={post.data.date.toISOString()}
  tags={post.data.tags}
>
  <article data-pagefind-body>
    <header class="article-header">
      <h1 data-pagefind-meta="title">{post.data.title}</h1>
      <time class="article-date" datetime={post.data.date.toISOString()}>{formatISODate(post.data.date)}</time>
      {post.data.cover && (
        <figure class="article-cover">
          <img src={post.data.cover.image} alt={post.data.cover.alt} />
        </figure>
      )}
    </header>

    {toc.length >= 3 && (
      <details class="article-toc" data-pagefind-ignore>
        <summary>文章目录</summary>
        <nav aria-label="文章目录">
          <ul>
            {toc.map((heading) => (
              <li class:list={{ "toc-subheading": heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    <div class="reading-prose">
      <Content />
    </div>

    <footer class="article-footer" data-pagefind-ignore>
      {post.data.lastmod && post.data.lastmod.getTime() > post.data.date.getTime() && (
        <p class="muted">更新于 <time datetime={post.data.lastmod.toISOString()}>{formatISODate(post.data.lastmod)}</time></p>
      )}
      {post.data.tags.length > 0 && (
        <p class="article-tags">
          {post.data.tags.map((tag) => <a href={`/blog/tag/${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </p>
      )}
      <p><a href="/blog">全部文章</a></p>
      {(prev || next) && (
        <nav class="post-navigation" aria-label="相邻文章">
          {prev && <p>上一篇：<a href={`/blog/${postSlug(prev)}`}>{prev.data.title}</a></p>}
          {next && <p>下一篇：<a href={`/blog/${postSlug(next)}`}>{next.data.title}</a></p>}
        </nav>
      )}
    </footer>

    {siteConfig.twikoo.envId && (
      <details class="article-comments" data-pagefind-ignore>
        <summary>评论</summary>
        <TwikooComments path={`/blog/${postSlug(post)}`} deferred />
      </details>
    )}
  </article>
  <ArticleEnhancements />
</ReadingLayout>
