---
import { render } from "astro:content";
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import { getPublishedPosts, formatISODate, postSlug, readingTime } from "@/lib/blog";
import { siteConfig } from "@/lib/config";
import TwikooComments from "@/components/interactive/TwikooComments.astro";
import ArticleEnhancements from "@/components/interactive/ArticleEnhancements.astro";
import ReadingTools from "@/components/interactive/ReadingTools.astro";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { slug: postSlug(post) },
    props: { post, prev: posts[index + 1] || null, next: posts[index - 1] || null },
  }));
}

const { post, prev, next } = Astro.props;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
---

<ReadingLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={post.data.cover?.image}
  ogImageAlt={post.data.cover?.alt}
  ogImageWidth={post.data.cover?.width}
  ogImageHeight={post.data.cover?.height}
  publishedTime={post.data.date.toISOString()}
  modifiedTime={post.data.lastmod?.toISOString()}
  tags={post.data.tags}
>
  <article data-pagefind-body>
    <header class="article-header">
      <h1 id="article-title" data-pagefind-meta="title">{post.data.title}</h1>
      <p class="article-meta" data-pagefind-ignore>
        <a href="/about" rel="author">{siteConfig.author}</a>
        <time class="article-date" datetime={post.data.date.toISOString()}>{formatISODate(post.data.date)}</time>
        <span>{readingTime(post.body || "")}</span>
      </p>
    </header>

    {toc.length >= 3 && (
      <details class="article-toc" data-pagefind-ignore>
        <summary>文章目录</summary>
        <nav aria-label="文章目录">
          <ul>
            {toc.map((heading) => (
              <li class:list={{ "toc-subheading": heading.depth === 3 }}>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </details>
    )}

    <div class="reading-prose">
      {post.data.cover && (
        <figure class="article-cover">
          <picture>
            {post.data.cover.srcset && (
              <source srcset={post.data.cover.srcset} sizes="(max-width: 600px) 90vw, (max-width: 748px) calc(100vw - 48px), 700px" type="image/webp" />
            )}
            <img src={post.data.cover.image} alt={post.data.cover.alt} width={post.data.cover.width} height={post.data.cover.height} data-full-image={post.data.cover.image} decoding="async" />
          </picture>
        </figure>
      )}
      <Content />
    </div>

    <footer class="article-footer" data-pagefind-ignore>
      {post.data.lastmod && post.data.lastmod.getTime() > post.data.date.getTime() && (
        <p class="muted">更新于 <time datetime={post.data.lastmod.toISOString()}>{formatISODate(post.data.lastmod)}</time></p>
      )}
      {post.data.tags.length > 0 && (
        <p class="article-tags">
          {post.data.tags.map((tag) => <a href={`/blog/tag/${encodeURIComponent(tag)}`}>#{tag}</a>)}
        </p>
      )}
      <p><a href="/blog">全部文章</a></p>
      {(prev || next) && (
        <nav class="post-navigation" aria-label="相邻文章">
          {prev && <a href={"/blog/" + postSlug(prev)}><span>上一篇</span>{prev.data.title}</a>}
          {next && <a href={"/blog/" + postSlug(next)}><span>下一篇</span>{next.data.title}</a>}
        </nav>
      )}
    </footer>

    {siteConfig.twikoo.envId && (
      <details class="article-comments" data-pagefind-ignore>
        <summary>评论</summary>
        <TwikooComments path={`/blog/${postSlug(post)}`} deferred />
      </details>
    )}
  </article>
  <ArticleEnhancements />
  <ReadingTools title={post.data.title} headings={toc} />
</ReadingLayout>
