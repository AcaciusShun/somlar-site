---
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import PostArchive from "@/components/content/PostArchive.astro";
import { getPublishedPosts, getAllTags } from "@/lib/blog";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getAllTags(posts).map(({ tag }) => ({
    params: { tag },
    props: { tag, posts: posts.filter((post) => post.data.tags.includes(tag)) },
  }));
}

const { tag, posts } = Astro.props;
---

<ReadingLayout title={tag} description={`标签「${tag}」下的文章。`}>
  <p class="section-back"><a href="/blog">全部文章</a></p>
  <header class="listing-header">
    <h1>{tag}</h1>
    <span class="muted">{posts.length} 篇文章</span>
  </header>
  <PostArchive posts={posts} />
</ReadingLayout>
