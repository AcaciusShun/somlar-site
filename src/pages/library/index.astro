---
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import LibraryNote from "@/components/content/LibraryNote.astro";
import { fetchLibraryItems, type LibraryItem, type ShelfType } from "@/lib/neodb";

const items = [...await fetchLibraryItems()].sort((a, b) => b.date.localeCompare(a.date));
const shelves: Record<ShelfType, string> = {
  complete: "已完成", progress: "进行中", wishlist: "计划中", dropped: "已放下",
};
const categoryOptions = [
  { value: "", label: "全部类型" },
  { value: "book", label: "书籍" },
  { value: "movie,tv", label: "电影与剧集" },
  { value: "music", label: "音乐" },
  { value: "game", label: "游戏" },
  { value: "podcast", label: "播客" },
].filter((option) => !option.value || items.some((item) => option.value.split(",").includes(item.category)));
const shelfOptions = Object.entries(shelves).filter(([shelf]) => items.some((item) => item.shelf === shelf));
const byMonth = new Map<string, LibraryItem[]>();
for (const item of items) {
  const month = item.date.slice(0, 7);
  if (!byMonth.has(month)) byMonth.set(month, []);
  byMonth.get(month)!.push(item);
}
const months = [...byMonth.entries()].map(([key, entries]) => {
  const [year, month] = key.split("-");
  return { key, label: `${year} 年 ${Number(month)} 月`, entries };
});
---

<ReadingLayout title="Library" description="书籍、电影、剧集、音乐和游戏的个人记录与短评。">
  <h1>书影音与游戏</h1>
  <p>从 <a href="https://neodb.social">NeoDB</a> 同步的个人记录，按标记时间排列。</p>

  <div class="library-tools">
  <details class="library-filter-panel" id="library-filter-panel" hidden>
    <summary aria-labelledby="library-filter-label">
      <span class="library-filter-label" id="library-filter-label">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
          <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
        筛选
      </span>
      <span class="library-selection muted" id="library-selection" hidden></span>
    </summary>
    <form class="library-filters" id="library-filters" role="search" hidden>
    <div class="library-fields">
      <label class="library-query" for="library-search">
        <span class="visually-hidden">搜索标题、短评或标签</span>
        <input id="library-search" type="search" placeholder="搜索书影音…" autocomplete="off" autocapitalize="none" enterkeyhint="search" />
      </label>
      <label for="library-category">
        <span class="visually-hidden">类型</span>
        <select id="library-category">
          {categoryOptions.map((option) => <option value={option.value}>{option.label}</option>)}
        </select>
      </label>
      <label for="library-shelf">
        <span class="visually-hidden">状态</span>
        <select id="library-shelf">
          <option value="">全部状态</option>
          {shelfOptions.map(([value, label]) => <option value={value}>{label}</option>)}
        </select>
      </label>
    <button class="text-button library-reset" type="reset" hidden>清除</button>
    </div>
    </form>
  </details>

  <span class="library-count muted" id="library-count" role="status" aria-live="polite">{items.length} 条</span>
  </div>
  <p id="library-empty" hidden>没有匹配的记录。<button class="text-button" type="button" id="library-empty-reset">显示全部记录</button></p>

  {months.map((month) => (
    <section class="library-month" aria-labelledby={`month-${month.key}`}>
      <h2 id={`month-${month.key}`}>{month.label}</h2>
      <ul class="library-list">
        {month.entries.map((item) => (
          <li
            class="library-entry"
            id={`entry-${item.uuid}`}
            data-library-entry
            data-category={item.category}
            data-shelf={item.shelf}
            data-search={`${item.title} ${item.comment} ${item.tags.join(" ")}`}
          >
            <a class="library-cover" href={item.url} tabindex="-1" aria-hidden="true">
              {item.cover && <img src={item.cover} alt="" width="72" height="104" loading="lazy" decoding="async" />}
              <span class="library-cover-fallback" hidden={Boolean(item.cover)}>暂无封面</span>
            </a>
            <div class="library-info">
              <h3><a href={item.url}>{item.title}</a></h3>
              <p class="library-meta">
                <span>{shelves[item.shelf]}</span>
                <time datetime={item.date}>{item.date}</time>
              </p>
              {item.comment && (
                <details class="library-review">
                  <summary>短评{item.rating != null && `（${item.rating} / 10）`}</summary>
                  <LibraryNote text={item.comment} />
                </details>
              )}
            </div>
          </li>
        ))}
      </ul>
    </section>
  ))}
</ReadingLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("#library-filters");
  const filterPanel = document.querySelector<HTMLDetailsElement>("#library-filter-panel");
  // Width and input capability stay stable when the software keyboard changes height.
  const compactLayout = matchMedia("(max-width: 600px), (max-width: 900px) and (pointer: coarse)");
  const search = document.querySelector<HTMLInputElement>("#library-search");
  const category = document.querySelector<HTMLSelectElement>("#library-category");
  const shelf = document.querySelector<HTMLSelectElement>("#library-shelf");
  const count = document.querySelector<HTMLElement>("#library-count");
  const selection = document.querySelector<HTMLElement>("#library-selection");
  const reset = form?.querySelector<HTMLButtonElement>("[type=reset]");
  const empty = document.querySelector<HTMLElement>("#library-empty");
  const normalize = (value: string) => value.normalize("NFKC").toLocaleLowerCase();
  const entries = [...document.querySelectorAll<HTMLElement>("[data-library-entry]")].map((node) => ({
    node,
    search: normalize(node.dataset.search || ""),
    category: node.dataset.category || "",
    shelf: node.dataset.shelf || "",
  }));
  const months = [...document.querySelectorAll<HTMLElement>(".library-month")];

  document.querySelectorAll<HTMLImageElement>(".library-cover img").forEach((image) => {
    const showFallback = () => {
      image.hidden = true;
      image.nextElementSibling?.removeAttribute("hidden");
    };
    image.addEventListener("error", showFallback, { once: true });
    if (image.complete && image.naturalWidth === 0) showFallback();
  });

  if (form && search && category && shelf && count && empty) {
    const applyFilters = () => {
      const query = normalize(search.value.trim());
      const categories = category.value ? category.value.split(",") : [];
      let visible = 0;
      for (const entry of entries) {
        const matches = (!query || entry.search.includes(query))
          && (!categories.length || categories.includes(entry.category))
          && (!shelf.value || shelf.value === entry.shelf);
        entry.node.hidden = !matches;
        if (matches) visible++;
      }
      for (const month of months) {
        month.hidden = !month.querySelector("[data-library-entry]:not([hidden])");
      }
      count.textContent = visible === entries.length
        ? `${entries.length} 条`
        : `${visible} / ${entries.length} 条`;
      if (reset) reset.hidden = !query && !category.value && !shelf.value;
      if (selection) {
        selection.textContent = [
          category.value && category.selectedOptions[0]?.text,
          shelf.value && shelf.selectedOptions[0]?.text,
          search.value.trim() && `“${search.value.trim()}”`,
        ].filter(Boolean).join(" · ");
        selection.hidden = !selection.textContent;
      }
      empty.hidden = visible > 0;
    };

    search.addEventListener("input", applyFilters);
    category.addEventListener("change", applyFilters);
    shelf.addEventListener("change", applyFilters);
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      applyFilters();
      if (compactLayout.matches && filterPanel) {
        filterPanel.open = false;
        filterPanel.querySelector("summary")?.focus({ preventScroll: true });
      } else if (matchMedia("(pointer: coarse)").matches) {
        search.blur();
      }
    });
    form.addEventListener("reset", (event) => {
      event.preventDefault();
      const resetHadFocus = document.activeElement === reset;
      search.value = "";
      category.value = "";
      shelf.value = "";
      applyFilters();
      if (resetHadFocus) search.focus({ preventScroll: true });
    });
    document.querySelector("#library-empty-reset")?.addEventListener("click", () => {
      form.reset();
      if (compactLayout.matches) filterPanel?.querySelector("summary")?.focus({ preventScroll: true });
      else {
        if (filterPanel) filterPanel.open = true;
        search.focus({ preventScroll: true });
      }
    });
    form.hidden = false;
    if (filterPanel) filterPanel.hidden = false;
    applyFilters();
  }
</script>

<style>
  .library-tools {
    position: relative;
    min-height: 44px;
    margin-block: 1.5rem 1rem;
  }

  .library-filter-panel > summary {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    min-width: 0;
    min-height: 44px;
    padding-right: 7.5rem;
    color: var(--reading-link);
    font-size: 0.875rem;
    list-style: none;
  }

  .library-filter-panel > summary::-webkit-details-marker { display: none; }
  .library-filter-label { display: inline-flex; align-items: center; gap: 0.35rem; flex-shrink: 0; }
  .library-filter-panel[open] .library-filter-label svg { transform: rotate(180deg); }
  .library-selection { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  .library-filters {
    margin-block: 0.5rem 1rem;
  }

  .library-fields {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 1.5rem;
  }

  label {
    min-width: 0;
  }

  .library-query { flex: 1 1 14rem; }
  label[for=library-category] { flex: 0 0 8.5rem; }
  label[for=library-shelf] { flex: 0 0 7rem; }

  input,
  select {
    display: block;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    margin: 0;
    padding: 0.4rem 0;
    border: 0;
    border-radius: 0;
    color: inherit;
    background-color: transparent;
  }

  input { border-bottom: 1px solid #8b969e; }
  select { cursor: pointer; }
  .library-reset { font-size: 0.875rem; }

  .library-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.75rem 2.5rem;
    list-style: none;
    padding: 0;
  }

  .library-entry {
    margin: 0;
    display: grid;
    grid-template-columns: 72px minmax(0, 1fr);
    align-items: start;
    gap: 1.1rem;
  }

  .library-cover {
    display: block;
    width: 72px;
    min-height: 104px;
  }

  .library-cover img {
    display: block;
    width: 72px;
    height: 104px;
    object-fit: contain;
    object-position: top left;
  }

  .library-cover-fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 72px;
    height: 104px;
    border: 1px solid var(--reading-rule);
    color: var(--reading-muted);
    font-size: 0.75rem;
  }

  .library-info {
    display: block;
    padding-top: 0.1rem;
  }

  .library-entry h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 500;
  }

  .library-entry h3 a {
    color: var(--reading-link);
    text-decoration: none;
  }

  .library-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0 1rem;
    margin: 0;
    color: var(--reading-muted);
    font-size: 0.8125rem;
  }

  .library-meta time {
    font-variant-numeric: tabular-nums;
  }

  .library-review {
    font-size: 0.95rem;
  }

  .library-review summary {
    color: var(--reading-link);
  }

  .library-count {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    align-items: center;
    min-height: 44px;
    font-size: 0.8125rem;
    font-variant-numeric: tabular-nums;
    pointer-events: none;
  }
  .library-month { margin-top: 2.5rem; }
  .library-month h2 {
    margin: 0 0 1.25rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--reading-rule);
    font-family: inherit;
    color: var(--reading-muted);
    font-size: 0.9375rem;
    font-weight: 500;
  }

  @media (hover: hover) and (pointer: fine) {
    .library-entry h3 a:hover { color: var(--reading-link); text-decoration: underline; }
  }

  @media (max-width: 600px), (max-width: 900px) and (pointer: coarse) {
    .library-fields {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr) auto;
      gap: 0.5rem 1rem;
    }

    .library-query {
      grid-column: 1 / -1;
    }

  }

  @media (max-width: 699px) {
    .library-list { display: block; }
    .library-entry { margin-bottom: 1.5rem; }
  }

  @media (max-width: 600px) {
    .library-entry {
      grid-template-columns: 64px minmax(0, 1fr);
      gap: 0.85rem;
      margin-bottom: 1.4rem;
    }

    .library-cover,
    .library-cover img,
    .library-cover-fallback {
      width: 64px;
      min-height: 96px;
    }

    .library-cover img,
    .library-cover-fallback {
      height: 96px;
    }

    .library-meta {
      gap: 0 0.75rem;
      font-size: 0.8125rem;
    }

    .library-entry h3 {
      margin-bottom: 0.35rem;
    }
  }
</style>
