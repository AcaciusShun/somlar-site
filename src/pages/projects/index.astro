---
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import ResourceList from "@/components/content/ResourceList.astro";

const projects = [
  {
    name: "Somlar",
    desc: "这个站点。用 Astro 构建，记录技术实践、阅读笔记与日常随想。",
    tech: ["Astro", "TypeScript", "CSS"],
    repo: "https://github.com/AcaciusShun/somlar-site",
    url: "https://somlar.com",
    category: "personal",
  },
  {
    name: "Somincola",
    desc: "一个自托管的 Mastodon 社区，包含社区维护、内容管理与配套站点。",
    tech: ["Ruby", "Astro", "Docker"],
    repo: "https://github.com/somincola",
    url: "https://somincola.org",
    category: "personal",
  },
  {
    name: "Mastodon News Center",
    desc: "Mastodon 新闻机器人管理工具，自动聚合 RSS，并发布到多个机器人账号。",
    tech: ["Python", "FastAPI", "Docker"],
    repo: "https://github.com/somincola/mastodon-news-center",
    category: "personal",
  },
  {
    name: "Moro",
    desc: "原生 Mastodon iOS 客户端，支持浏览时间线、发帖和通知。",
    tech: ["Swift", "SwiftUI", "iOS"],
    repo: "https://github.com/somincola/moro-ios",
    category: "personal",
  },
  {
    name: "Front-End Web Development with React",
    desc: "Coursera 课程项目：使用 React、Redux 和 React Router 构建餐厅单页应用。",
    tech: ["React", "Redux", "JavaScript"],
    repo: "https://github.com/coursera-learn/Front-End-Web-Development-with-React",
    category: "course",
  },
  {
    name: "Server-side Development with Node.js",
    desc: "Coursera 课程项目：使用 Express 和 MongoDB 构建 REST API，包含用户认证。",
    tech: ["Node.js", "Express", "MongoDB"],
    repo: "https://github.com/coursera-learn/Server-side-Development-with-NodeJS-Express-and-MongoDB",
    category: "course",
  },
  {
    name: "Full-Stack Web & Mobile App",
    desc: "Coursera 毕业项目：使用 Ionic / React Native 构建跨平台应用与配套后端。",
    tech: ["Ionic", "React Native", "HTML"],
    repo: "https://github.com/coursera-learn/Full-Stack-Web-and-Multiplatform-Mobile-App-",
    category: "course",
  },
];

const personal = projects.filter((p) => p.category === "personal");
const course = projects.filter((p) => p.category === "course");
---

<ReadingLayout title="Projects" description="我的个人项目、开源工具与课程作品。">
  <h1>项目</h1>
  <p>一些持续维护的项目，也有学习过程中做过的小作品。</p>

  <section aria-labelledby="personal-projects">
    <h2 id="personal-projects">个人项目</h2>
    <ResourceList items={personal} />
  </section>

  <section aria-labelledby="course-projects">
    <h2 id="course-projects">课程作品</h2>
    <p>在香港科技大学的 Coursera 全栈开发系列课程中完成。</p>
    <ResourceList items={course} />
  </section>
</ReadingLayout>
