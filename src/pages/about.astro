---
import ReadingLayout from "@/layouts/ReadingLayout.astro";

const skills = [
  { group: "语言", items: ["TypeScript", "JavaScript", "Python", "HTML5", "CSS3"] },
  { group: "框架", items: ["React", "Vue", "Next.js", "Astro", "React Native", "Expo", "FastAPI", "Node.js", "Tailwind CSS"] },
  { group: "数据", items: ["MongoDB", "Redis"] },
  { group: "工具与部署", items: ["Docker", "Vite", "Webpack", "Cloudflare", "GitHub Actions"] },
  { group: "兴趣", items: ["系统设计", "字体排印", "RSS / Fediverse"] },
];

const timeline = [
  { year: "2026", text: "搭建 Somlar，作为长期写作、记录和分享的个人站点。" },
  { year: "2025", text: "创建自托管的 Mastodon 社区 Somincola。" },
  { year: "2024", text: "完成香港科技大学的全栈 Web 开发系列课程。" },
];
---

<ReadingLayout title="About" description="关于 acacius。">
  <h1>关于我</h1>
  <p>我是 acacius。Somlar 是这个站点的名字。</p>
  <p>写代码，也写一些生活里的事。喜欢做有用的东西，记录真实的想法，把系统和文字都慢慢打磨好。</p>
  <p>这里放我的技术实践、阅读笔记、日常随想，以及一些小项目和实验。</p>

  <section aria-labelledby="moro-progress">
    <h2 id="moro-progress">正在开发 Moro</h2>
    <p>
      <a href="https://moro.somincola.com/">Moro</a> 是我用 Swift 和 SwiftUI 开发的原生 Mastodon iOS 客户端。
      目前已支持时间线浏览、发帖、搜索、通知、个人主页和多账号切换等主要功能。
    </p>
    <p>
      最近在完善图片、视频和 GIF 的浏览体验，以及动态头像的播放。
      同时持续打磨缓存、长列表滚动和资源占用，让日常阅读更顺畅、稳定。
    </p>
  </section>

  <section aria-labelledby="stack">
    <h2 id="stack">常用技术与兴趣</h2>
    <dl class="profile-details">
      {skills.map((group) => (
        <>
          <dt>{group.group}</dt>
          <dd>{group.items.join("、")}</dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="timeline">
    <h2 id="timeline">一些经历</h2>
    <ul>
      {timeline.map((item) => <li><strong>{item.year}</strong>：{item.text}</li>)}
    </ul>
  </section>

  <section aria-labelledby="elsewhere">
    <h2 id="elsewhere">在别处找到我</h2>
    <ul>
      <li><a href="https://github.com/AcaciusShun">GitHub</a></li>
      <li><a href="https://x.com/hey_akie">X</a></li>
      <li><a href="https://m.somincola.org/@acacius" rel="me">Mastodon</a></li>
      <li><a href="mailto:contact@somlar.com">contact@somlar.com</a></li>
    </ul>
  </section>
</ReadingLayout>
