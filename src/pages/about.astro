---
import ReadingLayout from "@/layouts/ReadingLayout.astro";
import { siteConfig } from "@/lib/config";

const skills = [
  { group: "语言", items: ["Swift", "TypeScript", "JavaScript", "Python", "HTML", "CSS"] },
  { group: "框架", items: ["SwiftUI", "React", "Vue", "Next.js", "Astro", "React Native", "Expo", "FastAPI", "Node.js", "Tailwind CSS"] },
  { group: "数据", items: ["MongoDB", "Redis"] },
  { group: "工具与部署", items: ["Docker", "Vite", "Webpack", "Cloudflare", "GitHub Actions"] },
  { group: "兴趣", items: ["系统设计", "字体排印", "RSS / Fediverse"] },
];

const experiences = [
  "开发原生 Mastodon iOS 客户端 Moro。",
  "创建并维护 Mastodon 社区 Somincola Garden。",
  "用 Astro 搭建并维护个人站点。",
  "完成香港科技大学在 Coursera 开设的全栈 Web 开发系列课程。",
];
---

<ReadingLayout title="About" description="我是 acacius，开发 Web 和 iOS 应用，也维护 Mastodon 社区 Somincola Garden。">
  <h1>关于我</h1>
  <p>我是 acacius。</p>
  <p>
    平时做 Web 和 iOS 应用，也维护 Mastodon 社区 <a href={siteConfig.links.community}>Somincola Garden</a>。
    这里记录开发中遇到的问题、阅读笔记和日常见闻。
  </p>

  <section aria-labelledby="moro-progress">
    <h2 id="moro-progress">正在开发 Moro</h2>
    <p>
      <a href={siteConfig.links.moro}>Moro</a> 是我用 Swift 和 SwiftUI 开发的原生 Mastodon iOS 客户端。
      目前已支持时间线浏览、发帖、搜索、通知、个人主页和多账号切换等主要功能。
    </p>
    <p>
      最近在完善图片、视频和 GIF 的浏览体验，以及动态头像的播放。
      同时持续打磨缓存、长列表滚动和资源占用，让日常阅读更顺畅、稳定。
    </p>
  </section>

  <section aria-labelledby="stack">
    <h2 id="stack">技术与兴趣</h2>
    <dl class="profile-details">
      {skills.map((group) => (
        <>
          <dt>{group.group}</dt>
          <dd>{group.items.join("、")}</dd>
        </>
      ))}
    </dl>
  </section>

  <section aria-labelledby="timeline">
    <h2 id="timeline">一些经历</h2>
    <ul>
      {experiences.map((text) => <li>{text}</li>)}
    </ul>
  </section>

  <section aria-labelledby="elsewhere">
    <h2 id="elsewhere">在别处找到我</h2>
    <ul>
      <li><a href="https://github.com/AcaciusShun">GitHub</a></li>
      <li><a href="https://x.com/hey_akie">X</a></li>
      <li><a href="https://m.somincola.org/@acacius" rel="me">Mastodon</a></li>
      <li><a href="mailto:contact@somlar.com">contact@somlar.com</a></li>
    </ul>
  </section>
</ReadingLayout>
